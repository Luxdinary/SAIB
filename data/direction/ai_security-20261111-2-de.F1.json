  {
   "id": "b3",
   "function": "explanation",
   "scene_type": "sc_inspect",
   "spoken": "Was das britische NCSC dazu sagt: Wer wechseln muss, wählt oft ein Passwort, das dem alten ähnelt. Angreifer können es dann ableiten. Neue Passwörter werden eher aufgeschrieben oder vergessen. Und viele wählen ein schwächeres.",
   "data": {
    "kicker": "Laut NCSC",
    "headline": "Was der Zwang bewirkt",
    "rows": [
     {
      "label": "Ähnlich",
      "value": "aus dem alten ableitbar",
      "verdict": "Folge",
      "at": "@ähnelt"
     },
     {
      "label": "Zettel",
      "value": "eher aufgeschrieben",
      "verdict": "Folge",
      "at": "@aufgeschrieben"
     },
     {
      "label": "Schwächer",
      "value": "leichter zu merken",
      "verdict": "Folge",
      "at": "@schwächeres"
     }
    ],
    "fact": {
     "kind": "fakt",
     "text": "Erzwungener Wechsel macht Passwörter oft schwächer.",
     "source": "NCSC · Passwortwechsel",
