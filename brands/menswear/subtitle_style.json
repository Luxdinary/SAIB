{
  "font_family": "Inter",
  "font_weight": 500,
  "font_size_px": 56,
  "min_font_size_px": 42,
  "text_transform": "none",
  "group_words": 4,
  "style": "italic-emphasis",
  "color": "#F2EEE6",
  "highlight_color": "#D4B483",
  "scrim": {
    "color": "#273245",
    "opacity": 0.0,
    "padding_px": 18,
    "radius_px": 16
  },
  "position": {
    "anchor": "bottom",
    "bottom_px": 640,
    "max_width_px": 900,
    "align": "center"
  },
  "line_height": 1.15,
  "letter_spacing_em": 0.0,
  "shadow": "0 4px 24px rgba(0,0,0,0.45)",
  "enter": {
    "kind": "fade-up",
    "seconds": 0.12
  },
  "exit": {
    "kind": "fade",
    "seconds": 0.12
  }
}
