    {"id": "S1", "url": "https://howthingsfly.si.edu/ask-an-explainer/how-does-sound-travel-space", "checked_at": "2026-11-01",
     "title": "Smithsonian National Air and Space Museum, How Things Fly, How does sound travel in space?: sound does not travel in space; sound requires molecules to travel through, and there are none in space because space is a vacuum",
     "label": {"de": "Smithsonian NASM", "en": "Smithsonian NASM"}},
    {"id": "S2", "url": "https://wtamu.edu/~cbaird/sq/2013/02/14/does-sound-travel-faster-in-space/", "checked_at": "2026-11-01",
     "title": "West Texas A&M University, Science Questions with Surprising Answers: sound does not travel at all in space; sound is vibrating air and the vacuum has essentially zero air; an exploding ship nearby would be silent, as would supernovas and crashing asteroids; inside an air-filled ship you hear the others; astronauts cannot talk directly even inches apart, not because of the helmets; space suits have two-way radios; radio is electromagnetic radiation like light and travels through the vacuum",
     "label": {"de": "West Texas A&M (Physik)", "en": "West Texas A&M (physics)"}}
  ],
  "de": {
    "title": "Im Weltall hört dich keiner – Plümo ruft Hallo",
    "hooks": [
      {"type": "misconception", "spoken": "Im Weltall hört dich keiner. Ich hab laut Hallo gerufen. Kein Echo, nichts.",
       "on_screen": "Im All hört dich *keiner*.", "scores": {"clarity": 5, "relevance": 4, "curiosity": 5, "truth": 5, "visual": 5},
       "source_ids": ["S1", "S2"], "visual": "Helm fliegt zur Faktentür, Stempel STILLE",
       "why": {"truth": "Smithsonian und West Texas A&M: Schall reist im All nicht, weil dort Vakuum ist", "visual": "Helm an der Tür mit Stempel STILLE ist sofort lesbar"}},
      {"type": "question", "spoken": "Warum hört man im Weltall keine Explosion?", "on_screen": "Warum *kein* Knall?",
       "scores": {"clarity": 4, "relevance": 4, "curiosity": 5, "truth": 5, "visual": 3}, "source_ids": ["S2"], "visual": "lautlose Explosion"},
      {"type": "surprising_fact", "spoken": "Zwei Astronauten können sich im All nicht zurufen, selbst ganz nah beieinander.", "on_screen": "Ganz nah und *trotzdem taub*.",
       "scores": {"clarity": 4, "relevance": 3, "curiosity": 4, "truth": 5, "visual": 3}, "source_ids": ["S2"], "visual": "zwei Helme nebeneinander"},
      {"type": "concrete_risk", "spoken": "Wer im All auf ein Echo wartet, wartet ewig.", "on_screen": "Echo im All? *Ewig warten.*",
       "scores": {"clarity": 4, "relevance": 3, "curiosity": 3, "truth": 4, "visual": 2}, "source_ids": ["S1"], "visual": "Plümo mit Uhr"},
      {"type": "demonstration", "spoken": "Ich halte meinen Lautsprecher ins All. Hör genau hin.", "on_screen": "Lautsprecher im *All*.",
       "scores": {"clarity": 4, "relevance": 3, "curiosity": 4, "truth": 4, "visual": 5}, "source_ids": ["S1"], "visual": "Lautsprecher ohne Ton"}
    ],
    "beats": [
      {"function": "hook", "scene_type": "zonk_scan", "source_ids": ["S1", "S2"],
       "spoken": "Im Weltall hört dich keiner. Ich hab laut Hallo gerufen. Kein Echo, nichts.",
       "data": {"mode": "hook", "head": "Im All hört dich *keiner*.", "head_at": 0.2, "sign": "NUR FAKTEN",
                "items": [{"kind": "helmet"}], "stamp_reject": "STILLE",
                "cue_scan": "Weltall", "cue_verdict": "keiner", "cue_club": "Hallo", "cue_know": "nichts"}},
      {"function": "problem", "scene_type": "zonk_word", "source_ids": ["S1"],
       "spoken": "Moment. Ich dachte, im All hallt es. Ich bin mit meiner Pappkarton-Rakete hoch und hab gerufen. Aber kein Echo. Ich war geschockt. Mein Lautsprecher auch.",
       "data": {"word_a": "Hallo", "word_b": "echo", "left": "Plümo: *Echo*", "right": "Echt: *Stille*",
                "cue_left": "dachte", "cue_strike": "kein", "cue_right": "Echo", "cue_react": "Ich",
                "item": "speaker", "cue_shock": "geschockt", "cue_item": "Lautsprecher", "cue_never": "auch"}},
      {"function": "explanation", "scene_type": "zonk_diagram", "source_ids": ["S1", "S2"],
       "spoken": "Was braucht Schall? Moleküle, durch die er reist. Schall ist schwingende Luft. Im All gibt es praktisch keine Luft, nur Vakuum. Ohne Hände zeig ich es mit dem Blatt.",
       "data": {"headline": "Was braucht *Schall*?", "inner": "soundwave", "disc": ["#101830", "#3a2a5c", "#1F1A3A"], "cue_q": "Schall",
                "labels": [{"text": "braucht *Moleküle*", "pos": "tr", "cue": "Moleküle"},
                           {"text": "Schall = *schwingende Luft*", "pos": "l", "cue": "schwingende"},
                           {"text": "im All: *Vakuum*", "pos": "b", "cue": "Vakuum"}],
                "cue_hands": "Hände", "cue_leaf": "Blatt"},
       "overlay": {"marker_at": "w:Moleküle"}},
      {"function": "demonstration", "scene_type": "zonk_zoom", "source_ids": ["S2"],
       "spoken": "Ganz genau. Sitzt du im Raumschiff und ein anderes explodiert, hörst du nichts. Drinnen hörst du die anderen, denn dort ist Luft. Auch Supernovas sind im All lautlos. Klingt langweilig. Für die Ohren schon.",
       "data": {"kind": "helmet", "lens": "soundwave", "lens_bg": "#101830", "cue_mag": "genau",
                "callouts": [{"text": "Explosion: *still*", "cue": "explodiert"}, {"text": "drinnen: *Luft*", "cue": "Drinnen"}],
                "cue_nut": "nichts", "stamp": {"text": "Lautlos!", "cue": "lautlos"}, "cue_react": "langweilig", "cue_fast": "Ohren"},
       "overlay": {"dim_at": "w:explodiert", "marker_at": "w:explodiert"}},
      {"function": "insight", "scene_type": "zonk_compare", "source_ids": ["S2"],
       "spoken": "Zwei Astronauten im All können sich nicht direkt zurufen, selbst ganz nah beieinander. Am Helm liegt das nicht. Deshalb haben Raumanzüge Funk. Funkwellen sind wie Licht, sie kommen durchs Vakuum. Ich hab nur einen Karton.",
       "data": {"headline": "Was kommt *durchs* All?",
                "bars": [{"label": "Schall", "value": "nein", "h": 0.22, "color": "#FF4D4D", "kind": "speaker", "cue": "zurufen"},
                         {"label": "Funk", "value": "kommt an", "h": 0.6, "color": "#B7FF00", "kind": "soundwave", "cue": "Funk"}],
                "stamp": {"text": "wie Licht!", "cue": "Licht"}, "cue_react": "Karton"},
       "overlay": {"marker_at": "w:Astronauten"}},
      {"function": "benefit", "scene_type": "zonk_scan",
       "spoken": "Merke: Keine Luft, kein Schall. Gut, jetzt ich. Ich ruf ganz laut ins All. Scanner läuft. Ergebnis: Echo nicht ermittelbar. Ich kipp beleidigt aus dem Karton.",
       "data": {"mode": "unknown", "sign": "NUR FAKTEN", "merke": "Keine Luft, *kein* Schall.",
                "display": "Echo: nicht ermittelbar", "plumps": "PLUMPS", "cue_build": "Schall",
                "cue_go": "Gut", "cue_scan": "Scanner", "cue_result": "Ergebnis", "cue_back": "kipp"},
       "overlay": {"marker_at": "w:Merke"}},
      {"function": "close", "scene_type": "zonk_loop",
       "spoken": "Ich bleib dann mal liegen. Mehr Zonkfruit? Folge dem Kanal. Ich steh gleich wieder auf.",
       "data": {"sign": "NUR FAKTEN", "cta": "Mehr Zonkfruit? *Folgen.*", "cue_cta": "Mehr", "cue_up": "steh", "cue_lie": "liegen", "cue_ch": "Kanal"}}
    ],
    "status": [
      {"beat": "b1", "text": "Weltall: hallt es?", "tone": "amber", "offset": 0.5},
      {"beat": "b1", "text": "Echo: abgelehnt", "tone": "pop", "word": "keiner"},
      {"beat": "b3", "text": "Schall braucht Moleküle", "tone": "lime", "word": "Moleküle"},
      {"beat": "b4", "text": "Explosion: lautlos", "tone": "lime", "word": "explodiert"},
      {"beat": "b5", "text": "Astronauten: per Funk", "tone": "lime", "word": "Funk"},
      {"beat": "b6", "text": "Plümo: Echo offen", "tone": "amber", "word": "Ergebnis"},
      {"beat": "b7", "text": "Plümo: liegt kurz", "tone": "muted", "offset": 0.3}
    ],
    "post": {"title": "Im Weltall hört dich keiner. Plümo hat Hallo gerufen.",
             "description": "Plümo ist mit seiner Pappkarton-Rakete ins All und hat auf ein Echo gewartet. Dabei braucht Schall Moleküle, und im All ist Vakuum. Astronauten sprechen deshalb über Funk: Funkwellen kommen wie Licht durchs Vakuum.",
             "hashtags": ["weltall", "physik", "wusstestdu", "funfact", "zonkfruit", "comedy"]}
