    },
    {
      "id": "b3",
      "function": "explanation",
      "scene_type": "rv_chart",
      "spoken": "Number one: intake opens, typically up to fifteen degrees before top dead centre, according to the lecture. Number two: intake closes, typically thirty to fifty degrees after bottom dead centre. Watch the first two marks appear.",
      "data": {
        "title": "Intake: open and close",
        "kind": "valve_lift",
        "series_at": [
