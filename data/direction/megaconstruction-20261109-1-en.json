  "beats": [
    {
      "id": "b1",
      "function": "hook",
      "scene_type": "gs_hook",
      "spoken": "They say you can see the Great Wall of China from space. NASA says: not with the naked eye.",
      "data": {
        "kicker": "Myth check · Great Wall",
        "question": "Visible from space? NASA: not with the naked eye",
        "question_at": "@They",
        "badge": {
          "text": "Myth check",
          "at_word": "NASA",
          "y": 1000
        }
      },
      "source_ids": [
        "S2"
      ],
      "overlay": {
