          "y": 1010
        }
      },
      "source_ids": [
        "S1"
      ]
    },
    {
      "id": "b2",
      "function": "problem",
      "scene_type": "gb_load",
      "spoken": "The finding in 1990: at the start of 1990 the tower was closed to visitors, and an international committee took over. The task: reduce the lean without putting the tower at risk.",
      "data": {
        "headline": "The finding",
        "load": {
          "label": "Tower closed to visitors",
          "value": "1990",
          "unit": "",
          "sub": "international committee takes over",
          "at": "@1990",
          "dy": 540
        },
        "goal": {
          "key": "TASK",
          "text": "Reduce the lean",
          "at": "@committee",
          "dy": 420
        }
      },
      "source_ids": [
        "S2",
        "S3"
      ]
    },
    {
      "id": "b3",
      "function": "explanation",
      "scene_type": "gb_principle",
      "spoken": "The solution is a surprise: they did not prop the tower up, they took soil away from under it. In 1993 and 1994, lead weights were first placed on the north side. From February 1999, soil was carefully extracted beneath the north side.",
      "data": {
        "headline": "The reason",
        "note": "lean exaggerated",
        "pins": [
          {
            "anchor": "north",
            "text": "North side: soil out",
            "at": "@February",
            "side": "down"
          }
        ],
        "rule": {
          "text": "Don't prop it: take soil away.",
          "at": "@soil",
          "dy": 640
        }
      },
      "source_ids": [
        "S2",
        "S4"
      ]
    },
    {
      "id": "b4",
      "function": "demonstration",
      "scene_type": "gb_calc",
      "spoken": "The check in numbers: according to the cathedral works, the lean fell by about 1,900 arc seconds. Divided by 3,600, that is a little over half a degree. At the seventh cornice, the overhang went back by 460 millimetres.",
      "data": {
        "headline": "The check",
        "sheet_dy": 470,
        "calcs": [
          {
            "label": "Arc seconds ÷ 3,600 = degrees",
            "a": {
              "value": 1900,
              "unit": "″",
              "show": "1,900″"
            },
            "op": "÷",
            "b": {
              "value": 3600,
              "unit": ""
            },
            "unit": "°",
            "round": 0.01,
            "decimals": 2,
            "prefix": "≈ ",
            "expect": 0.53,
            "at": "@1,900",
            "result_at": "@half"
          }
        ],
        "pins": [
          {
            "anchor": "cornice",
            "text": "−460 mm",
            "kind": "dim",
            "at": "@460"
          }
        ]
      },
      "source_ids": [
        "S1"
      ]
    },
    {
      "id": "b5",
      "function": "insight",
      "scene_type": "gb_proof",
      "spoken": "Since December 2001 the tower has been open again. Its lean is now back to where it was at the start of the nineteenth century.",
      "data": {
        "headline": "The verdict",
        "stamp": {
          "date": "12/2001",
          "event": "reopened",
          "at": "@December",
          "dy": 150
