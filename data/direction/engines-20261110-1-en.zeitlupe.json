  {
   "id": "b3",
   "function": "explanation",
   "scene_type": "zlx_readout",
   "spoken": "The engineering lecture does the maths. At one thousand revolutions per minute, the crank turns six degrees per millisecond. At twelve hundred it is seven point two degrees, so seven hundred and twenty degrees take exactly one hundred milliseconds. It is simple arithmetic, but it shows how little time there is.",
   "data": {
    "title": "Degrees per millisecond",
    "gauge_max": 7,
    "gauge_value": 1.2,
    "gauge_unit": "× 1000 rpm",
    "gauge_at": "w:revolutions",
    "lines": [
     {
      "text": "1000 rpm → 6° per ms",
      "hl": "6°",
      "at": "w:crank"
     },
     {
      "text": "1200 rpm → 7.2° per ms",
      "hl": "7.2°",
      "at": "w:is"
     },
     {
      "text": "720° ÷ 7.2 °/ms = 100 ms",
      "hl": "100 ms",
      "at": "w:take"
     }
    ],
    "theta": [
