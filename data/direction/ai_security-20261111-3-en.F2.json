  {
   "id": "b2",
   "function": "problem",
   "scene_type": "sc_inspect",
   "spoken": "What's inside an update like that? According to Germany's BSI, updates close security gaps. Those are weaknesses attackers can use, for example to sneak in malware. And installing later? The BSI says: absolutely not.",
   "data": {
    "kicker": "According to the BSI",
    "headline": "What's in the update",
    "rows": [
     {
      "label": "Content",
      "value": "closes gaps",
      "verdict": "important",
      "at": "@gaps"
     },
     {
      "label": "Gap",
      "value": "a way in for malware",
      "verdict": "open",
      "at": "@malware"
     },
     {
      "label": "Later",
      "value": "absolutely not",
      "verdict": "BSI",
      "at": "@absolutely"
     }
    ],
    "fact": {
     "kind": "fakt",
     "text": "Updates close the gaps that malware comes through.",
     "source": "BSI · software updates",
     "at": 1.4
    }
   },
