    {
      "id": "b2",
      "function": "problem",
      "scene_type": "rv_cutaway",
      "spoken": "With direct injection, the fuel only evaporates inside the cylinder. Evaporating needs heat, and it takes that heat from the incoming air. The charge gets cooler. It is the same effect as the chill of water evaporating on wet skin. The spray you see here is that fuel.",
      "data": {
        "title": "Evaporation cools",
        "injector": "direct",
        "notes": [
          {
            "text": "evaporates",
            "at": "w:evaporates",
            "side": "r",
            "y": 900,
            "to": [
              540,
              590
            ]
          },
          {
            "text": "air cooler",
            "at": "w:cooler",
            "side": "l",
            "y": 760,
            "to": [
