  "beats": [
    {
      "id": "b1",
      "function": "hook",
      "scene_type": "gb_task",
      "spoken": "How do you build 632 metres high without the wind gripping the tower too hard? The Shanghai Tower, finished in 2015 with 128 floors above ground, solved that task twice.",
      "data": {
        "kicker": "Task · Shanghai Tower",
        "question": "632 metres against the wind: how?",
        "question_at": 0.05,
        "pins": [
          {
            "anchor": "top",
            "text": "632 m",
            "kind": "dim",
            "at": "@632"
          }
        ],
        "tag": {
          "text": "Shanghai · finished 2015",
          "at": "@Shanghai",
          "y": 1010
        }
      },
      "source_ids": [
        "S1"
      ]
    },
    {
      "id": "b2",
      "function": "problem",
      "scene_type": "gb_principle",
      "spoken": "Solution one is the shape. The tower narrows towards the top and twists by 120 degrees on the way. According to the designers, that cuts the wind load by 24 percent compared with a rectangular tower of the same height. Inside, two glass skins wrap nine zones with atriums.",
      "data": {
        "headline": "Solution 1: shape",
        "note": "cross-section schematic",
        "rule": {
          "text": "Twist and taper: 24 % less wind load",
          "at": "@24",
          "dy": 660
        }
      },
      "source_ids": [
        "S1",
        "S2",
        "S3"
      ]
    },
    {
      "id": "b3",
      "function": "explanation",
      "scene_type": "gb_build",
      "spoken": "Solution two hangs at the top: since 2016 a 1,000 tonne pendulum damper has worked there, braked by eddy currents. According to a conference paper, it is meant to cut wind-induced acceleration by around 45 percent.",
      "data": {
        "headline": "Solution 2: pendulum",
        "rows": [
          {
            "pos": "1",
            "part": "Pendulum mass",
            "qty": "1,000 t",
            "at": "@1,000"
          },
          {
            "pos": "2",
            "part": "Eddy-current brake since",
            "qty": "2016",
            "at": "@2016"
          },
          {
            "pos": "3",
            "part": "Goal: less acceleration",
            "qty": "≈ 45 %",
            "at": "@45"
          }
        ]
      },
      "source_ids": [
        "S4"
      ]
    },
    {
      "id": "b4",
      "function": "close",
      "scene_type": "gb_close",
      "spoken": "Add 106 lift cars, the fastest at up to 20.5 metres per second, and 1,079 bored piles at the bottom. A tower that twists so the wind grips it less. Follow Gigastruct for the next engineering task.",
      "data": {
        "statement": "Solved: shape plus pendulum",
