    },
    {
      "id": "b4",
      "function": "explanation",
      "scene_type": "rv_chart",
      "spoken": "Number three: exhaust opens, thirty to fifty degrees before bottom dead centre. Number four: exhaust closes, up to fifteen degrees after top dead centre. And here are the two exhaust marks.",
