      "function": "hook",
      "scene_type": "gb_task",
      "spoken": "Is the Leaning Tower of Pisa about to fall over? You hear that a lot. Let's check what the cathedral works and the engineers say.",
      "data": {
        "kicker": "Check · Pisa",
        "question": "Is the Leaning Tower about to fall?",
