  {
   "id": "b4",
   "function": "insight",
   "scene_type": "comparison",
   "duration_hint": 14,
   "spoken": "The key point for small businesses: Copilot only surfaces company data the person has at least view permission for. That's why Microsoft advises setting permissions properly, for example in SharePoint. Anything shared too widely, Copilot finds faster.",
   "data": {
    "headline": "What Copilot can see",
    "mode": "versus",
