    ],
    "post": {"title": "Auf dem Berg kocht Wasser kühler. Plümo war oben.",
             "description": "Plümo dachte, am Gipfel ist man näher an der Sonne und das Wasser wird heißer. Falsch: Oben ist der Luftdruck niedriger, und Wasser siedet früher. Meereshöhe 212 °F, auf 7.500 Fuß nur 198 °F. Darum braucht Gekochtes oben länger.",
             "hashtags": ["wasser", "physik", "wusstestdu", "funfact", "zonkfruit", "comedy"]}
  },
  "en": {
    "title": "Water boils cooler on a mountain – Plümo and the summit thermometer",
    "hooks": [
      {"type": "misconception", "spoken": "Water on a mountain doesn't boil hotter. It boils cooler. I climbed up to check.",
       "on_screen": "Up high, water boils *cooler*.", "scores": {"clarity": 5, "relevance": 4, "curiosity": 5, "truth": 5, "visual": 5},
       "source_ids": ["S1", "S2"], "visual": "pot flies to the Fact Door, stamp NOPE",
       "why": {"truth": "NMSU and CSU: lower air pressure, water boils at a lower temperature", "visual": "stamped pot reads at once"}},
      {"type": "question", "spoken": "Does water boil hotter or cooler on a mountain?", "on_screen": "Mountain: *hotter* or cooler?",
       "scores": {"clarity": 4, "relevance": 4, "curiosity": 5, "truth": 5, "visual": 3}, "source_ids": ["S1", "S2"], "visual": "thermometer swings"},
      {"type": "surprising_fact", "spoken": "At 7,500 feet, water already boils at 198 degrees Fahrenheit.", "on_screen": "7,500 ft: *198 °F*.",
       "scores": {"clarity": 3, "relevance": 3, "curiosity": 4, "truth": 5, "visual": 3}, "source_ids": ["S1", "S2"], "visual": "thermometer drops"},
      {"type": "concrete_risk", "spoken": "Cook up high like you do at sea level and your food takes longer.", "on_screen": "Up high: *cooks longer*.",
       "scores": {"clarity": 4, "relevance": 4, "curiosity": 3, "truth": 5, "visual": 2}, "source_ids": ["S2"], "visual": "clock next to the pot"},
      {"type": "demonstration", "spoken": "I take a thermometer up the mountain. Watch.", "on_screen": "Thermometer on the *summit*.",
       "scores": {"clarity": 4, "relevance": 3, "curiosity": 4, "truth": 4, "visual": 5}, "source_ids": [], "visual": "Plümo with thermometer on the mountain"}
    ],
    "beats": [
      {"function": "hook", "scene_type": "zonk_scan", "source_ids": ["S1", "S2"],
       "spoken": "Water on a mountain doesn't boil hotter. It boils cooler. I climbed up to check.",
       "data": {"mode": "hook", "head": "Up high, water boils *cooler*.", "head_at": 0.2, "sign": "FACTS ONLY",
                "items": [{"kind": "pot"}], "stamp_reject": "NOPE",
                "cue_scan": "Water", "cue_verdict": "doesn't", "cue_club": "cooler", "cue_know": "climbed"}},
      {"function": "problem", "scene_type": "zonk_word", "source_ids": ["S1", "S2"],
       "spoken": "Wait. I thought the summit is closer to the sun, so water boils hotter. But no peak heat. It's the air pressure. I was shocked. My thermometer was shocked too.",
       "data": {"word_a": "Peak", "word_b": "heat", "left": "Plümo: *closer to sun*", "right": "Real: *air pressure*",
                "cue_left": "thought", "cue_strike": "no", "cue_right": "pressure", "cue_react": "I",
                "item": "thermometer", "cue_shock": "shocked", "cue_item": "thermometer", "cue_never": "too"}},
      {"function": "explanation", "scene_type": "zonk_diagram", "source_ids": ["S1", "S2"],
       "spoken": "Higher up, the air pressure drops. The blanket of air above you is lighter. And with less pressure, water boils at a lower temperature. No hands, so I point with my leaf.",
       "data": {"headline": "What does the *air* do?", "inner": "mountain", "disc": ["#3A2A6B", "#EEE6FF", "#B9A2D8"], "cue_q": "air",
                "labels": [{"text": "pressure *drops* up high", "pos": "tr", "cue": "pressure"},
                           {"text": "air blanket: *lighter*", "pos": "l", "cue": "blanket"},
                           {"text": "water boils *cooler*", "pos": "b", "cue": "boils"}],
                "cue_hands": "hands", "cue_leaf": "leaf"},
       "overlay": {"marker_at": "w:pressure"}},
      {"function": "demonstration", "scene_type": "zonk_zoom", "source_ids": ["S1", "S2"],
       "spoken": "Closer. Sea level: water boils at two hundred twelve degrees Fahrenheit. Every five hundred feet up, about one degree less. At seven thousand five hundred feet: one ninety-eight. The boiling point. Rude.",
       "data": {"kind": "mountain", "lens": "thermometer", "lens_bg": "#2A2140", "cue_mag": "Closer",
                "callouts": [{"text": "sea level: *212 °F*", "cue": "Sea"}, {"text": "7,500 ft: *198 °F*", "cue": "seven"}],
                "cue_nut": "Every", "stamp": {"text": "Boiling point!", "cue": "boiling"}, "cue_react": "Rude"},
       "overlay": {"dim_at": "w:Sea", "marker_at": "w:Sea"}},
      {"function": "insight", "scene_type": "zonk_compare", "source_ids": ["S2"],
       "spoken": "The Colorado table: sea level, two twelve. Seven thousand five hundred feet, one ninety-eight. Ten thousand feet, one ninety-three. So boiled food takes longer. I blame the sun.",
       "data": {"headline": "Higher up, *cooler* boil",
                "bars": [{"label": "sea level", "value": "212 °F", "h": 0.95, "color": "#FF4D4D", "cue": "sea"},
                         {"label": "7,500 ft", "value": "198 °F", "h": 0.78, "color": "#FF8A5C", "cue": "Seven"},
                         {"label": "10,000 ft", "value": "193 °F", "h": 0.68, "color": "#B7FF00", "kind": "mountain", "cue": "Ten"}],
                "stamp": {"text": "Cooks longer!", "cue": "longer"}, "cue_react": "blame"},
       "overlay": {"marker_at": "w:Colorado"}},
      {"function": "benefit", "scene_type": "zonk_scan",
       "spoken": "Remember: higher up, less air pressure, so water boils cooler. Right, my turn. Thermometer on. Result: heat unknown. I guess I'm not soup.",
       "data": {"mode": "unknown", "sign": "FACTS ONLY", "merke": "Less air pressure: water boils *cooler*.",
                "display": "Heat: unknown", "plumps": "FLOP", "cue_build": "cooler",
                "cue_go": "Right", "cue_scan": "Thermometer", "cue_result": "Result", "cue_back": "guess"},
       "overlay": {"marker_at": "w:Remember"}},
      {"function": "close", "scene_type": "zonk_loop",
       "spoken": "I'll just lie here for a bit. More Zonkfruit? Follow the channel. I'll get up in a minute.",
       "data": {"sign": "FACTS ONLY", "cta": "More Zonkfruit? *Follow.*", "cue_cta": "More", "cue_up": "get", "cue_lie": "lie", "cue_ch": "channel"}}
    ],
    "status": [
      {"beat": "b1", "text": "Summit: hotter water?", "tone": "amber", "offset": 0.5},
      {"beat": "b1", "text": "Peak heat: rejected", "tone": "pop", "word": "doesn't"},
      {"beat": "b3", "text": "Up high: less air pressure", "tone": "lime", "word": "pressure"},
      {"beat": "b4", "text": "7,500 ft: 198 °F", "tone": "lime", "word": "seven"},
      {"beat": "b5", "text": "Up high: food cooks longer", "tone": "lime", "word": "longer"},
      {"beat": "b6", "text": "Plümo: heat unknown", "tone": "amber", "word": "Result"},
      {"beat": "b7", "text": "Plümo: lying down", "tone": "muted", "offset": 0.3}
    ],
    "post": {"title": "Water boils cooler on a mountain. Plümo checked.",
             "description": "Plümo thought the summit is closer to the sun, so water gets hotter. Wrong: up high the air pressure is lower and water boils sooner. Sea level 212 °F, at 7,500 feet only 198 °F. That's why boiled food takes longer up there.",
             "hashtags": ["water", "science", "funfact", "didyouknow", "zonkfruit", "comedy"]}
  }
