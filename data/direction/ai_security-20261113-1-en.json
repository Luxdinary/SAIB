   "id": "b3",
   "function": "explanation",
   "scene_type": "file_beside",
   "duration_hint": 13,
   "spoken": "Hence the NCSC's first rule: at any time, at least one backup is offline. Only connect it when absolutely necessary. And unplug a USB drive as soon as the backup is done.",
   "data": {
    "headline": "The offline rule",
    "file_label": "Backup",
    "card": {
     "title": "According to the NCSC",
     "rows": [
      {
       "text": "at least one backup offline",
       "ok": null
      },
      {
       "text": "connect only when needed",
       "ok": null
      },
      {
       "text": "unplug the drive afterwards",
       "ok": null
      }
     ]
    },
    "tag": "",
    "row_step": 2.8,
    "file_marker": "none"
   },
   "source_ids": [
