      {"type": "misconception", "spoken": "A starfish is not a fish. I invited it to a swim race. No reply.",
       "on_screen": "A starfish is *not* a fish.", "scores": {"clarity": 5, "relevance": 4, "curiosity": 5, "truth": 5, "visual": 5},
