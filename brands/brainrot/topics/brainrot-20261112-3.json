       "text": "Kompass: *Sonne*",
       "pos": "tr",
       "cue": "Sonne"
      },
      {
       "text": "*Winkel* = Richtung",
       "pos": "l",
       "cue": "Senkrechten"
      },
      {
       "text": "60° links = *60° links*",
       "pos": "b",
       "cue": "Futter"
      }
     ],
     "cue_hands": "Hände",
     "cue_leaf": "Blatt"
    },
    "overlay": {
