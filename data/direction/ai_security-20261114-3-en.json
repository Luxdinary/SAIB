       "ok": "open"
      },
      {
       "text": "written on notes",
       "ok": "open"
      }
     ]
    },
    "right": {
     "title": "In a manager",
     "rows": [
      {
       "text": "a separate one per account",
       "ok": null
      },
      {
       "text": "creates and fills them",
       "ok": null
      },
      {
       "text": "warns on a wrong address",
       "ok": null
