    {
      "id": "b3",
      "function": "explanation",
      "scene_type": "rv_readout",
      "spoken": "Die Fachvorlesung rechnet es vor. Bei tausend Umdrehungen pro Minute dreht die Kurbel sechs Grad pro Millisekunde. Bei zwölfhundert sind es sieben Komma zwei Grad, und siebenhundertzwanzig Grad dauern damit genau hundert Millisekunden. Das ist die Grundrechnung.",
      "data": {
        "title": "Grad pro Millisekunde",
        "gauge_max": 7,
        "gauge_value": 1.2,
        "gauge_unit": "× 1000 U/min",
        "gauge_at": "w:Umdrehungen",
        "lines": [
          {
            "text": "1000 U/min → 6° pro ms",
            "hl": "6°",
            "at": "w:Kurbel"
          },
          {
            "text": "1200 U/min → 7,2° pro ms",
            "hl": "7,2°",
            "at": "w:sind"
