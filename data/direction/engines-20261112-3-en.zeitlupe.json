   ]
  },
  {
   "id": "b3",
   "function": "explanation",
   "scene_type": "zlx_board",
   "spoken": "Then you compare against two reference fuels. Isooctane resists knock very well and gets the number one hundred. Normal heptane knocks easily and gets the number zero. Every petrol is rated on the same scale.",
   "data": {
    "title": "Two references",
    "mode": "compare",
