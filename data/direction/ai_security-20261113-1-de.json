  {
   "id": "b4",
   "function": "insight",
   "scene_type": "comparison",
   "duration_hint": 13,
   "spoken": "Die zweite Säule ist die 3-2-1-Regel: mindestens drei Kopien, auf zwei Geräten, eine davon außer Haus. Das NCSC weist darauf hin: Diese Regel allein verlangt keine Offline-Kopie. Darum braucht es beides.",
   "data": {
    "headline": "3-2-1 und offline",
    "mode": "versus",
