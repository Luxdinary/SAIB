      "source_ids": [
        "S1"
      ]
    },
    {
      "id": "b3",
      "function": "explanation",
      "scene_type": "gb_principle",
      "spoken": "The solution: a steel cantilever bridge. Three double cantilevers carry two suspended centre spans. Each of the two main openings is 518 metres wide.",
