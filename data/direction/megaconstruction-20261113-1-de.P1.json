  "beats": [
    {
      "id": "b1",
      "function": "hook",
      "scene_type": "gb_task",
      "spoken": "Wie baut man 632 Meter hoch, ohne dass der Wind den Turm zu stark packt? Der Shanghai Tower, fertig 2015 mit 128 Stockwerken über der Erde, löste diese Aufgabe gleich zweimal.",
      "data": {
        "kicker": "Bauaufgabe · Shanghai Tower",
        "question": "632 Meter gegen den Wind: wie?",
        "question_at": 0.05,
        "pins": [
          {
            "anchor": "top",
            "text": "632 m",
            "kind": "dim",
            "at": "@632"
          }
        ],
        "tag": {
          "text": "Shanghai · fertig 2015",
          "at": "@Shanghai",
          "y": 1010
        }
      },
      "source_ids": [
        "S1"
      ]
    },
    {
      "id": "b2",
      "function": "problem",
      "scene_type": "gb_principle",
      "spoken": "Lösung eins ist die Form. Der Turm verjüngt sich nach oben und dreht sich dabei um 120 Grad. Laut Planern senkt das die Windlast um 24 Prozent gegenüber einem rechteckigen Turm gleicher Höhe. Innen umschließen zwei Glashäute neun Zonen mit Atrien.",
      "data": {
        "headline": "Lösung 1: die Form",
        "note": "Querschnitt schematisch",
        "rule": {
          "text": "Drehen und verjüngen: 24 % weniger Windlast",
          "at": "@24",
          "dy": 660
        }
      },
      "source_ids": [
        "S1",
        "S2",
        "S3"
      ]
    },
    {
      "id": "b3",
      "function": "explanation",
      "scene_type": "gb_build",
      "spoken": "Lösung zwei hängt im Kopf des Turms: Seit 2016 arbeitet dort ein Pendeldämpfer mit 1.000 Tonnen, gebremst mit Wirbelstrom. Laut Fachbeitrag soll er die Beschleunigung bei Wind um rund 45 Prozent senken.",
      "data": {
        "headline": "Lösung 2: das Pendel",
        "rows": [
          {
            "pos": "1",
            "part": "Pendelmasse",
            "qty": "1.000 t",
            "at": "@1.000"
          },
          {
            "pos": "2",
            "part": "Wirbelstrombremse seit",
            "qty": "2016",
            "at": "@2016"
          },
          {
            "pos": "3",
            "part": "Ziel: weniger Beschleunigung",
            "qty": "≈ 45 %",
            "at": "@45"
          }
        ]
      },
      "source_ids": [
        "S4"
      ]
    },
    {
      "id": "b4",
      "function": "close",
      "scene_type": "gb_close",
      "spoken": "Dazu 106 Aufzugskabinen, die schnellsten mit bis zu 20,5 Metern pro Sekunde, und unten tragen 1.079 Bohrpfähle. Insgesamt bietet der Turm 420.000 Quadratmeter Geschossfläche. Ein Turm, der sich dreht, damit der Wind weniger angreift. Folge Gigastruct für die nächste Bauaufgabe.",
      "data": {
        "statement": "Gelöst: Form plus Pendel",
        "sheet": "BLATT 13",
