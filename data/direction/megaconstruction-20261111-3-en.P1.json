      "source_ids": [
        "S1"
      ]
    },
    {
      "id": "b3",
      "function": "explanation",
      "scene_type": "gb_principle",
      "spoken": "At both ends are the large locks built between 1911 and 1914, with chambers of 310 by 42 metres.",
