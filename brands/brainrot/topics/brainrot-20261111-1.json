  "en": {
    "title": "Why does ice float? – Plümo dunks the ice cube",
    "hooks": [
      {"type": "misconception", "spoken": "Ice doesn't float out of spite. I pushed it under. It pops back up.",
       "on_screen": "Ice *doesn't* float out of spite.", "scores": {"clarity": 5, "relevance": 5, "curiosity": 4, "truth": 5, "visual": 5},
       "source_ids": ["S1", "S2"], "visual": "ice cube flies to the lab door, stamp NOPE",
       "why": {"truth": "USGS and Penn State: ice is less dense than liquid water, so it floats", "visual": "ice cube at the door reads at once"}},
      {"type": "question", "spoken": "Why does an ice cube float instead of sinking?", "on_screen": "Why does *ice* float?",
       "scores": {"clarity": 5, "relevance": 5, "curiosity": 4, "truth": 5, "visual": 3}, "source_ids": ["S1"], "visual": "ice cube in a glass"},
      {"type": "surprising_fact", "spoken": "Only about ten percent of an ice cube sticks out of the water.", "on_screen": "Only *10 %* sticks out.",
       "scores": {"clarity": 4, "relevance": 4, "curiosity": 4, "truth": 5, "visual": 4}, "source_ids": ["S1"], "visual": "line on the ice cube"},
      {"type": "concrete_risk", "spoken": "If ice were denser than water, water would freeze from the bottom up.", "on_screen": "Freezing *bottom up*?",
       "scores": {"clarity": 4, "relevance": 3, "curiosity": 4, "truth": 4, "visual": 2}, "source_ids": ["S2"], "visual": "glass freezing from below"},
      {"type": "demonstration", "spoken": "I push the ice cube under water with my leaf. Watch.", "on_screen": "Ice cube, *down*.",
       "scores": {"clarity": 4, "relevance": 3, "curiosity": 4, "truth": 4, "visual": 5}, "source_ids": ["S1"], "visual": "cube pops back up"}
    ],
    "beats": [
      {"function": "hook", "scene_type": "zonk_scan", "source_ids": ["S1", "S2"],
       "spoken": "Ice doesn't float out of spite. I pushed it under. It pops back up.",
       "data": {"mode": "hook", "head": "Ice *doesn't* float out of spite.", "head_at": 0.2, "sign": "PLÜMO LAB",
                "items": [{"kind": "icecube"}], "stamp_reject": "NOPE",
                "cue_scan": "Ice", "cue_verdict": "doesn't", "cue_club": "pushed", "cue_know": "pops"}},
      {"function": "problem", "scene_type": "zonk_word", "source_ids": ["S2"],
       "spoken": "Wait. I thought the ice cube had a tiny buoy inside. But there's no buoy, just frozen water. I was shocked. The glass was too.",
       "data": {"word_a": "Ice ", "word_b": "buoy", "left": "Plümo: *tiny buoy*", "right": "Real: *just water*",
                "cue_left": "thought", "cue_strike": "no", "cue_right": "frozen", "cue_react": "was",
                "item": "glass", "cue_shock": "shocked", "cue_item": "glass", "cue_never": "too"}},
      {"function": "explanation", "scene_type": "zonk_diagram", "source_ids": ["S1", "S2"],
       "spoken": "Why on top? Freezing lines the molecules up in a lattice. Hydrogen bonds keep them farther apart than in liquid. No hands, so I point with my leaf.",
       "data": {"headline": "Why on *top*?", "inner": "icecube", "disc": ["#3A6F98", "#F2FBFF", "#BFE9FF"], "cue_q": "top",
                "labels": [{"text": "a regular *lattice*", "pos": "tr", "cue": "lattice"},
                           {"text": "*hydrogen bonds*", "pos": "l", "cue": "Hydrogen"},
                           {"text": "molecules: *farther apart*", "pos": "b", "cue": "farther"}],
                "cue_hands": "hands", "cue_leaf": "leaf"},
       "overlay": {"marker_at": "w:lattice"}},
      {"function": "demonstration", "scene_type": "zonk_zoom", "source_ids": ["S1"],
       "spoken": "Closer. Ice has only about ninety percent of water's density. About ten percent of an ice cube sticks out. Icebergs too. I call it water with a view.",
       "data": {"kind": "glass", "lens": "icecube", "lens_bg": "#1A3A5C", "cue_mag": "Closer",
                "callouts": [{"text": "ice: *about 90 %*", "cue": "ninety"}, {"text": "*10 %* sticks out", "cue": "ten"}],
                "cue_nut": "density", "stamp": {"text": "Icebergs too!", "cue": "Icebergs"}, "cue_react": "view"},
       "overlay": {"dim_at": "w:ninety", "marker_at": "w:ninety"}},
      {"function": "insight", "scene_type": "zonk_compare", "source_ids": ["S1", "S2"],
       "spoken": "Most substances get denser when solid. Water does the opposite. Denser ice would sink, and water would freeze from the bottom up. So aquatic life survives under the ice, at around four degrees. Cozy.",
       "data": {"headline": "Which is *denser*?",
                "bars": [{"label": "water", "value": "100 %", "h": 0.6, "color": "#3AA0E0", "kind": "glass", "cue": "Water"},
                         {"label": "ice", "value": "about 90 %", "h": 0.54, "color": "#BFE9FF", "kind": "icecube", "cue": "ice"}],
                "stamp": {"text": "4 °C under ice", "cue": "four"}, "cue_react": "Cozy"},
       "overlay": {"marker_at": "w:Water"}},
      {"function": "benefit", "scene_type": "zonk_scan",
       "spoken": "Remember: ice is less dense than water. Right, my turn. I push the cube down. Scanner on. Result: winner unknown. I tip off the rim.",
       "data": {"mode": "unknown", "sign": "PLÜMO LAB", "merke": "Ice: *less dense* than water.",
                "display": "Winner: unknown", "plumps": "FLOP", "cue_build": "less",
                "cue_go": "Right", "cue_scan": "Scanner", "cue_result": "Result", "cue_back": "tip"},
       "overlay": {"marker_at": "w:Remember"}},
      {"function": "close", "scene_type": "zonk_loop",
       "spoken": "I'll just lie here for a bit. More Zonkfruit? Follow the channel. I'll get up in a minute.",
       "data": {"sign": "PLÜMO LAB", "cta": "More Zonkfruit? *Follow.*", "cue_cta": "More", "cue_up": "get", "cue_lie": "lie", "cue_ch": "channel"}}
    ],
