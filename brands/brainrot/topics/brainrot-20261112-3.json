     "kind": "bee",
     "lens": "stopwatch",
     "lens_bg": "#2C1638",
     "cue_mag": "genau",
     "callouts": [
      {
       "text": "länger wackeln: *weiter*",
       "cue": "länger"
      },
      {
       "text": "2,5 s: *ca. 2625 m*",
       "cue": "2,5"
      }
     ],
     "cue_nut": "weiter",
