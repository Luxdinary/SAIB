          ]
        ],
        "fade_in": false,
        "fade_out": false
      },
      "overlay": {
        "marker": "fakt",
        "marker_at": "w:camshaft",
        "kicker": "2 · THE DIAGRAM",
        "transition": {
          "type": "blende",
          "seconds": 0.7
