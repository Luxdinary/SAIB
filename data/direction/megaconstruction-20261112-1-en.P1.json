    },
    {
      "id": "b2",
      "function": "problem",
      "scene_type": "gb_load",
      "spoken": "Back then: the bridge was built from 1869 to 1883. Its main span is about 486 metres, and its towers needed solid ground below the East River.",
      "data": {
        "headline": "Back then",
        "load": {
          "label": "Main span",
          "value": "486",
          "unit": "m",
          "sub": "1,595.5 ft per NYC DOT",
