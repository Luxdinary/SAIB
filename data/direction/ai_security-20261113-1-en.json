    }
   }
  },
  {
   "id": "b4",
   "function": "insight",
   "scene_type": "comparison",
   "duration_hint": 13,
   "spoken": "The second pillar is the 3-2-1 rule: at least three copies, on two devices, one of them offsite. The NCSC points out that this rule on its own does not require an offline copy. That's why you need both.",
   "data": {
    "headline": "3-2-1 plus offline",
    "mode": "versus",
    "left_at": 0.4,
    "right_at": 7.5,
    "left": {
     "title": "The 3-2-1 rule",
     "rows": [
      {
       "text": "3 copies",
       "ok": null
      },
      {
       "text": "2 devices",
       "ok": null
      },
      {
       "text": "1 offsite",
       "ok": null
      }
     ]
    },
    "right": {
     "title": "You also need",
     "rows": [
      {
       "text": "one copy offline",
       "ok": "open"
      },
      {
       "text": "or everything is reachable",
