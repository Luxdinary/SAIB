    {
      "id": "b5",
      "function": "insight",
      "scene_type": "rv_readout",
      "spoken": "According to Oak Ridge National Laboratory, knock limits the efficiency of petrol engines. More compression means more efficiency, but also more tendency to knock. The engineering lecture puts the limit at about twelve and a half to one with port injection and thirteen and a half with direct injection. It is one of the main limits in petrol engine design.",
      "data": {
        "title": "Compression limit",
        "figure": "bars",
        "bar_max": 15,
        "lines_y": 1010,
        "bars": [
          {
            "label": "port injection",
            "value": 12.5,
            "text": "≈ 12.5 : 1",
            "at": "w:port"
          },
          {
            "label": "direct injection",
            "value": 13.5,
            "text": "≈ 13.5 : 1",
            "at": "w:direct"
          }
        ],
        "lines": [
          {
            "text": "more compression → more efficiency",
            "hl": "efficiency",
            "at": "w:efficiency#2"
          },
          {
            "text": "… but more knock tendency",
            "hl": "knock",
            "at": "w:tendency"
          }
        ],
        "theta": [
