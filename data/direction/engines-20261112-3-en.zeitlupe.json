   ]
  },
  {
   "id": "b4",
   "function": "demonstration",
   "scene_type": "zlx_readout",
   "spoken": "If a petrol knocks exactly like a blend of ninety-five percent isooctane and five percent heptane, its octane number is ninety-five. So the number is a share by volume.",
   "data": {
    "title": "Example 95",
    "figure": "bars",
