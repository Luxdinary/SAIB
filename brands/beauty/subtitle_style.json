{
  "font_family": "Inter",
  "font_weight": 600,
  "font_size_px": 56,
  "min_font_size_px": 42,
  "text_transform": "none",
  "group_words": 3,
  "style": "highlight-word",
  "color": "#4A2F34",
  "highlight_color": "#9B5560",
  "scrim": {
    "color": "#FFFCF9",
    "opacity": 0.0,
    "padding_px": 18,
    "radius_px": 16
  },
  "position": {
    "anchor": "bottom",
    "bottom_px": 540,
    "max_width_px": 800,
    "align": "center"
  },
  "line_height": 1.15,
  "letter_spacing_em": 0.0,
  "shadow": "0 0 2px #F8F3EF, 0 0 14px #F8F3EF, 0 0 26px #F8F3EF",
  "enter": {
    "kind": "fade-up",
    "seconds": 0.12
  },
  "exit": {
    "kind": "fade",
    "seconds": 0.12
  },
  "note": "Dewlane 0.9: deep mauve on ivory (10.9:1), highlight deep rose (4.9:1); an ivory halo instead of a dark shadow keeps captions readable over the light background clips. Sense groups via plan layout caption_mode phrases."
}
