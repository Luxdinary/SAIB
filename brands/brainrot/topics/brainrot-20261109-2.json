                "callouts": [{"text": "fruitlets *fuse*", "cue": "fruitlets"}, {"text": "middle: the *stem*", "cue": "stem"}],
                "cue_nut": "juicy", "stamp": {"text": "Syncarp!", "cue": "syncarp"}, "cue_react": "carp", "cue_fast": "rhythm"},
       "overlay": {"dim_at": "w:fruitlets", "marker_at": "w:fruitlets"}},
      {"function": "insight", "scene_type": "zonk_scan", "source_ids": ["S1", "S2"],
       "spoken": "Let me count. Fruitlet one, fruitlet two, fruitlet three. One hundred to two hundred flowers make just as many fruitlets. On top sits the crown, a tuft of short, stiff leaves. Not counting those.",
       "data": {"mode": "accept", "sign": "FRUIT ONLY", "counter": "Fruitlets:", "stamp_accept": "GANG: YES",
                "items": [{"kind": "fruitlet", "word": "one"}, {"kind": "fruitlet", "word": "two"}, {"kind": "fruitlet", "word": "three"}],
                "cue_all": "many", "cue_react": "crown", "cue_why": "counting", "cue_shrug": "those"},
       "overlay": {"marker_at": "w:hundred"}},
      {"function": "benefit", "scene_type": "zonk_scan",
       "spoken": "Remember: a pineapple is many fused fruitlets. Right, my turn. I'll nod hello to each one. Scanner on. Result: headcount unknown. I'm dizzy.",
       "data": {"mode": "unknown", "sign": "FRUIT ONLY", "merke": "Pineapple: *many* fused fruitlets.",
