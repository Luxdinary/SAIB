{
  "font_family": "Inter",
  "font_weight": 700,
  "font_size_px": 56,
  "min_font_size_px": 42,
  "text_transform": "none",
  "group_words": 3,
  "style": "highlight-word",
  "color": "#E7ECF1",
  "highlight_color": "#2F9BFF",
  "scrim": {
    "color": "#222932",
    "opacity": 0.0,
    "padding_px": 18,
    "radius_px": 12
  },
  "position": {
    "anchor": "bottom",
    "bottom_px": 540,
    "max_width_px": 800,
    "align": "center"
  },
  "line_height": 1.15,
  "letter_spacing_em": 0,
  "shadow": "0 2px 8px rgba(0,0,0,0.5)",
  "enter": {
    "kind": "fade-up",
    "seconds": 0.12
  },
  "exit": {
    "kind": "fade",
    "seconds": 0.12
  },
  "note": "Revlore 0.9 (2026-10-30): normal case in meaning groups (plan caption_mode phrases, max 4 words), Inter 700, highlight word in the accent blue; replaces the Phase-1 draft (Oswald uppercase, 3 words)."
}