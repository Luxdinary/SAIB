        "title": "Zwei Formeln",
        "figure": "cylinder",
        "lines_y": 1000,
        "bore_label": "Luft",
        "stroke_label": "Volumen",
        "stroke_at": "w:Verdichtungsverhältnis",
        "fill_at": 0.05,
        "lines": [
          {
            "text": "p₂ / p₁ = ε ^ γ",
            "hl": "γ",
            "at": "w:Druck"
          },
          {
            "text": "T₂ / T₁ = ε ^ (γ − 1)",
            "hl": "γ − 1",
            "at": "w:Temperatur"
          },
          {
            "text": "γ ≈ 1,4 für Luft",
            "hl": "1,4",
            "at": "w:Luft"
