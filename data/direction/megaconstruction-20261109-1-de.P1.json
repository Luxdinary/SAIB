  "beats": [
    {
      "id": "b1",
      "function": "hook",
      "scene_type": "gb_task",
      "spoken": "Die Chinesische Mauer soll man aus dem All sehen können. Stimmt das? Die NASA hat dazu eine klare Antwort.",
      "data": {
        "kicker": "Prüfstand · Chinesische Mauer",
        "question": "Sieht man die Mauer aus dem All?",
        "question_at": 0.05,
        "tag": {
          "text": "Behauptung: aus dem All sichtbar",
          "at": "@Stimmt",
          "y": 1010
        }
      },
      "source_ids": [
        "S2"
      ]
    },
    {
      "id": "b2",
      "function": "problem",
      "scene_type": "gb_principle",
      "spoken": "Oft heißt es sogar, sie sei das einzige Bauwerk, das man aus dem All sieht. Die NASA nennt das einen Mythos. Vom Mond aus ist sie nicht zu sehen, aus der Erdumlaufbahn mit bloßem Auge schwer bis gar nicht.",
      "data": {
        "headline": "Der Befund",
        "note": "laut NASA",
        "rule": {
          "text": "Mond: nein. Umlaufbahn: bloßes Auge kaum.",
          "at": "@Mond",
          "dy": 640
        }
      },
      "source_ids": [
        "S1",
        "S2"
      ]
    },
    {
      "id": "b3",
      "function": "explanation",
      "scene_type": "gb_load",
      "spoken": "Der Grund ist nicht nur die Entfernung. Entscheidend ist der Kontrast, schreibt die NASA. Die Mauer hebt sich kaum von Vegetation und Boden ab. Satellitensensoren erkennen sie deshalb leichter als das menschliche Auge.",
      "data": {
        "headline": "Der Grund",
        "load": {
          "label": "Entscheidend",
          "value": "Kontrast",
          "unit": "",
          "sub": "nicht nur die Entfernung",
          "at": "@Kontrast",
          "dy": 540
        },
        "goal": {
          "key": "BILD",
          "text": "Mauer hebt sich kaum ab",
          "at": "@Vegetation",
          "dy": 420
        },
        "pins": [
          {
            "anchor": "wall",
            "text": "Mauer",
            "at": "@Mauer",
            "side": "up"
          }
        ]
      },
      "source_ids": [
        "S3"
      ]
    },
    {
      "id": "b4",
      "function": "demonstration",
      "scene_type": "gb_proof",
      "spoken": "Mit Teleobjektiv sieht es anders aus. Leroy Chiao, Kommandant der Expedition 10, hat die Mauer von der Raumstation aus fotografiert. Auch auf manchen hochauflösenden Astronautenfotos ist sie zu erkennen. Das Foto entstand also mit langer Brennweite, nicht mit bloßem Auge.",
      "data": {
        "headline": "Die Gegenprobe",
        "stamp": {
          "date": "EXPEDITION 10",
          "event": "Foto von der ISS",
          "at": "@Expedition",
          "dy": 150
        },
        "pins": [
          {
            "anchor": "far",
            "text": "Teleobjektiv: ja",
            "at": "@fotografiert",
            "side": "up"
          }
        ]
      },
      "source_ids": [
        "S1",
        "S2"
      ]
    },
    {
      "id": "b5",
      "function": "close",
      "scene_type": "gb_close",
      "spoken": "Also: fotografierbar ja, mit bloßem Auge nein. Chinas erster Astronaut Yang Liwei sagte, er habe die Mauer nicht gesehen. Unsichtbar ist sie im All also nicht, aber man sieht sie eben auch nicht einfach so. Folge Gigastruct für den nächsten Prüfstand.",
      "data": {
        "statement": "Urteil: mit bloßem Auge nein",
        "sheet": "BLATT 02",
        "rows": [
          [
