     "label": {"de": "CSU Extension (Colorado)", "en": "CSU Extension (Colorado)"}}
  ],
  "de": {
    "title": "Auf dem Berg kocht Wasser kühler – Plümo und das Gipfel-Thermometer",
    "hooks": [
      {"type": "misconception", "spoken": "Wasser kocht oben nicht heißer, sondern kühler. Ich hab extra den Berg bestiegen.",
       "on_screen": "Oben kocht Wasser *kühler*.", "scores": {"clarity": 5, "relevance": 4, "curiosity": 5, "truth": 5, "visual": 5},
       "source_ids": ["S1", "S2"], "visual": "Topf fliegt zur Faktentür, Stempel IRRTUM",
       "why": {"truth": "NMSU und CSU: weniger Luftdruck, Wasser siedet bei niedrigerer Temperatur", "visual": "Topf mit Stempel ist sofort lesbar"}},
      {"type": "question", "spoken": "Wird Wasser auf dem Berg heißer oder kühler?", "on_screen": "Berg: *heißer* oder kühler?",
       "scores": {"clarity": 4, "relevance": 4, "curiosity": 5, "truth": 5, "visual": 3}, "source_ids": ["S1", "S2"], "visual": "Thermometer pendelt"},
      {"type": "surprising_fact", "spoken": "Auf 7.500 Fuß siedet Wasser schon bei 198 Grad Fahrenheit.", "on_screen": "7.500 Fuß: *198 °F*.",
       "scores": {"clarity": 3, "relevance": 3, "curiosity": 4, "truth": 5, "visual": 3}, "source_ids": ["S1", "S2"], "visual": "Thermometer sinkt"},
      {"type": "concrete_risk", "spoken": "Wer oben kocht wie im Tal, wundert sich: Gekochtes braucht länger.", "on_screen": "Oben: *länger garen*.",
       "scores": {"clarity": 4, "relevance": 4, "curiosity": 3, "truth": 5, "visual": 2}, "source_ids": ["S2"], "visual": "Uhr neben dem Topf"},
      {"type": "demonstration", "spoken": "Ich nehm ein Thermometer mit auf den Gipfel. Schau.", "on_screen": "Thermometer am *Gipfel*.",
       "scores": {"clarity": 4, "relevance": 3, "curiosity": 4, "truth": 4, "visual": 5}, "source_ids": [], "visual": "Plümo mit Thermometer am Berg"}
    ],
    "beats": [
      {"function": "hook", "scene_type": "zonk_scan", "source_ids": ["S1", "S2"],
       "spoken": "Wasser kocht oben nicht heißer, sondern kühler. Ich hab extra den Berg bestiegen.",
       "data": {"mode": "hook", "head": "Oben kocht Wasser *kühler*.", "head_at": 0.2, "sign": "NUR FAKTEN",
                "items": [{"kind": "pot"}], "stamp_reject": "IRRTUM",
                "cue_scan": "Wasser", "cue_verdict": "nicht", "cue_club": "kühler", "cue_know": "Berg"}},
      {"function": "problem", "scene_type": "zonk_word", "source_ids": ["S1", "S2"],
       "spoken": "Moment. Ich dachte, oben am Gipfel ist man näher an der Sonne, also kocht es heißer. Aber keine Berghitze. Es liegt am Luftdruck. Ich war geschockt. Mein Thermometer auch.",
       "data": {"word_a": "Berg", "word_b": "hitze", "left": "Plümo: *näher an Sonne*", "right": "Echt: *Luftdruck*",
                "cue_left": "dachte", "cue_strike": "keine", "cue_right": "Luftdruck", "cue_react": "Ich",
                "item": "thermometer", "cue_shock": "geschockt", "cue_item": "Thermometer", "cue_never": "auch"}},
      {"function": "explanation", "scene_type": "zonk_diagram", "source_ids": ["S1", "S2"],
       "spoken": "Je höher man ist, desto niedriger der Luftdruck. Die Luftdecke über einem ist leichter. Und bei weniger Druck siedet Wasser schon bei niedrigerer Temperatur. Ohne Hände zeig ich's mit dem Blatt.",
       "data": {"headline": "Was macht die *Luft*?", "inner": "mountain", "disc": ["#3A2A6B", "#EEE6FF", "#B9A2D8"], "cue_q": "Luftdruck",
                "labels": [{"text": "Luftdruck *sinkt* oben", "pos": "tr", "cue": "höher"},
                           {"text": "Luftdecke *leichter*", "pos": "l", "cue": "Luftdecke"},
                           {"text": "Wasser siedet *früher*", "pos": "b", "cue": "siedet"}],
                "cue_hands": "Hände", "cue_leaf": "Blatt"},
       "overlay": {"marker_at": "w:Luftdruck"}},
      {"function": "demonstration", "scene_type": "zonk_zoom", "source_ids": ["S1", "S2"],
       "spoken": "Ganz genau. Auf Meereshöhe siedet Wasser bei 212 Grad Fahrenheit. Je 500 Fuß höher sinkt das um etwa ein Grad. Auf 7.500 Fuß: nur noch 198. Fachleute sagen Siedepunkt. Ich sage: frech.",
       "data": {"kind": "mountain", "lens": "thermometer", "lens_bg": "#2A2140", "cue_mag": "genau",
                "callouts": [{"text": "Meereshöhe: *212 °F*", "cue": "Meereshöhe"}, {"text": "7.500 Fuß: *198 °F*", "cue": "nur"}],
                "cue_nut": "sinkt", "stamp": {"text": "Siedepunkt!", "cue": "Siedepunkt"}, "cue_react": "sage", "cue_fast": "frech"},
       "overlay": {"dim_at": "w:Meereshöhe", "marker_at": "w:Meereshöhe"}},
      {"function": "insight", "scene_type": "zonk_compare", "source_ids": ["S2"],
       "spoken": "Die Tabelle aus Colorado: Meereshöhe 212 Grad, 7.500 Fuß 198, und ganz oben, 10.000 Fuß, 193. Darum braucht Gekochtes oben länger. Ich hab trotzdem zur Sonne geschielt.",
       "data": {"headline": "Je höher, desto *kühler*",
                "bars": [{"label": "Meereshöhe", "value": "212 °F", "h": 0.95, "color": "#FF4D4D", "cue": "Meereshöhe"},
                         {"label": "7.500 Fuß", "value": "198 °F", "h": 0.78, "color": "#FF8A5C", "cue": "Fuß"},
                         {"label": "10.000 Fuß", "value": "193 °F", "h": 0.68, "color": "#B7FF00", "kind": "mountain", "cue": "ganz"}],
                "stamp": {"text": "länger garen!", "cue": "länger"}, "cue_react": "geschielt"},
       "overlay": {"marker_at": "w:Tabelle"}},
      {"function": "benefit", "scene_type": "zonk_scan",
       "spoken": "Merke: Je höher, desto weniger Luftdruck, und Wasser siedet kühler. Gut, jetzt ich. Thermometer an. Ergebnis: Hitze nicht ermittelbar. Ich bin wohl keine Suppe.",
       "data": {"mode": "unknown", "sign": "NUR FAKTEN", "merke": "Weniger Luftdruck: Wasser siedet *kühler*.",
                "display": "Hitze: nicht ermittelbar", "plumps": "PLUMPS", "cue_build": "kühler",
                "cue_go": "Gut", "cue_scan": "Thermometer", "cue_result": "Ergebnis", "cue_back": "wohl"},
       "overlay": {"marker_at": "w:Merke"}},
      {"function": "close", "scene_type": "zonk_loop",
       "spoken": "Ich bleib dann mal liegen. Mehr Zonkfruit? Folge dem Kanal. Ich steh gleich wieder auf.",
       "data": {"sign": "NUR FAKTEN", "cta": "Mehr Zonkfruit? *Folgen.*", "cue_cta": "Mehr", "cue_up": "steh", "cue_lie": "liegen", "cue_ch": "Kanal"}}
    ],
    "status": [
      {"beat": "b1", "text": "Gipfel: Wasser heißer?", "tone": "amber", "offset": 0.5},
      {"beat": "b1", "text": "Gipfelhitze: abgelehnt", "tone": "pop", "word": "nicht"},
      {"beat": "b3", "text": "Oben weniger Luftdruck", "tone": "lime", "word": "Luftdruck"},
      {"beat": "b4", "text": "7.500 Fuß: 198 °F", "tone": "lime", "word": "nur"},
      {"beat": "b5", "text": "Oben: Gekochtes braucht länger", "tone": "lime", "word": "länger"},
      {"beat": "b6", "text": "Plümo: Hitze offen", "tone": "amber", "word": "Ergebnis"},
