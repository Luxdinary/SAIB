   "id": "b3",
   "function": "explanation",
   "scene_type": "file_beside",
   "duration_hint": 13,
   "spoken": "Daher die erste Regel des NCSC: Zu jeder Zeit ist mindestens ein Backup offline. Verbinde es nur, wenn es nötig ist. Und ein USB-Laufwerk abziehen, sobald die Sicherung fertig ist.",
   "data": {
    "headline": "Die Offline-Regel",
    "file_label": "Datensicherung",
    "card": {
     "title": "Laut NCSC",
     "rows": [
      {
