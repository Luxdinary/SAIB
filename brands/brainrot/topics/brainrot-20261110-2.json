  "en": {
    "title": "In space nobody can hear you – Plümo yells hello",
    "hooks": [
      {"type": "misconception", "spoken": "In space, nobody can hear you. I yelled hello. No echo, nothing.",
       "on_screen": "In space, *nobody* hears you.", "scores": {"clarity": 5, "relevance": 4, "curiosity": 5, "truth": 5, "visual": 5},
       "source_ids": ["S1", "S2"], "visual": "helmet flies to the Fact Door, stamp SILENCE",
       "why": {"truth": "Smithsonian and West Texas A&M: sound does not travel in space because space is a vacuum", "visual": "helmet at the door with a SILENCE stamp reads at once"}},
      {"type": "question", "spoken": "Why can't you hear an explosion in space?", "on_screen": "Why *no* boom?",
       "scores": {"clarity": 4, "relevance": 4, "curiosity": 5, "truth": 5, "visual": 3}, "source_ids": ["S2"], "visual": "silent explosion"},
      {"type": "surprising_fact", "spoken": "Two astronauts in space can't yell to each other, even inches apart.", "on_screen": "Inches apart, *still deaf*.",
       "scores": {"clarity": 4, "relevance": 3, "curiosity": 4, "truth": 5, "visual": 3}, "source_ids": ["S2"], "visual": "two helmets side by side"},
      {"type": "concrete_risk", "spoken": "Wait for an echo in space and you will wait forever.", "on_screen": "Echo in space? *Wait forever.*",
       "scores": {"clarity": 4, "relevance": 3, "curiosity": 3, "truth": 4, "visual": 2}, "source_ids": ["S1"], "visual": "Plümo with a clock"},
      {"type": "demonstration", "spoken": "I hold my speaker out into space. Listen closely.", "on_screen": "A speaker in *space*.",
       "scores": {"clarity": 4, "relevance": 3, "curiosity": 4, "truth": 4, "visual": 5}, "source_ids": ["S1"], "visual": "speaker with no sound"}
    ],
    "beats": [
      {"function": "hook", "scene_type": "zonk_scan", "source_ids": ["S1", "S2"],
       "spoken": "In space, nobody can hear you. I yelled hello. No echo, nothing.",
       "data": {"mode": "hook", "head": "In space, *nobody* hears you.", "head_at": 0.2, "sign": "FACTS ONLY",
                "items": [{"kind": "helmet"}], "stamp_reject": "SILENCE",
                "cue_scan": "space", "cue_verdict": "nobody", "cue_club": "yelled", "cue_know": "nothing"}},
      {"function": "problem", "scene_type": "zonk_word", "source_ids": ["S1"],
       "spoken": "Wait. I thought space would echo. I flew up in my cardboard rocket and shouted. But no echo. I was shocked. My speaker was too.",
       "data": {"word_a": "Hello ", "word_b": "echo", "left": "Plümo: *an echo*", "right": "Real: *silence*",
                "cue_left": "thought", "cue_strike": "But", "cue_right": "echo", "cue_react": "was",
                "item": "speaker", "cue_shock": "shocked", "cue_item": "speaker", "cue_never": "too"}},
      {"function": "explanation", "scene_type": "zonk_diagram", "source_ids": ["S1", "S2"],
       "spoken": "What does sound need? Molecules to travel through. Sound is just vibrating air. And space has essentially zero air. It's a vacuum. No hands, so I point with my leaf.",
       "data": {"headline": "What does *sound* need?", "inner": "soundwave", "disc": ["#101830", "#3a2a5c", "#1F1A3A"], "cue_q": "sound",
                "labels": [{"text": "needs *molecules*", "pos": "tr", "cue": "Molecules"},
                           {"text": "sound = *vibrating air*", "pos": "l", "cue": "vibrating"},
                           {"text": "space: *a vacuum*", "pos": "b", "cue": "vacuum"}],
                "cue_hands": "hands", "cue_leaf": "leaf"},
       "overlay": {"marker_at": "w:Molecules"}},
      {"function": "demonstration", "scene_type": "zonk_zoom", "source_ids": ["S2"],
       "spoken": "Closer. Sit in a spaceship while another one explodes, and you hear nothing. Inside, you can hear the others, the ship is full of air. Supernovas are silent too. Sounds boring.",
       "data": {"kind": "helmet", "lens": "soundwave", "lens_bg": "#101830", "cue_mag": "Closer",
                "callouts": [{"text": "explosion: *silent*", "cue": "explodes"}, {"text": "inside: *air*", "cue": "Inside"}],
                "cue_nut": "nothing", "stamp": {"text": "Silent!", "cue": "silent"}, "cue_react": "boring"},
       "overlay": {"dim_at": "w:explodes", "marker_at": "w:explodes"}},
      {"function": "insight", "scene_type": "zonk_compare", "source_ids": ["S2"],
       "spoken": "Two astronauts in space can't just yell to each other, even inches apart. It's not the helmets. So space suits have radios. Radio is like light: it crosses the vacuum. I only have a box.",
       "data": {"headline": "What crosses *space*?",
                "bars": [{"label": "sound", "value": "no", "h": 0.22, "color": "#FF4D4D", "kind": "speaker", "cue": "yell"},
                         {"label": "radio", "value": "yes", "h": 0.6, "color": "#B7FF00", "kind": "soundwave", "cue": "radios"}],
                "stamp": {"text": "like light!", "cue": "light"}, "cue_react": "box"},
       "overlay": {"marker_at": "w:astronauts"}},
      {"function": "benefit", "scene_type": "zonk_scan",
       "spoken": "Remember: no air, no sound. Right, my turn. I shout really loud into space. Scanner on. Result: echo unknown. I tip out of my box.",
       "data": {"mode": "unknown", "sign": "FACTS ONLY", "merke": "No air, *no* sound.",
                "display": "Echo: unknown", "plumps": "FLOP", "cue_build": "sound",
                "cue_go": "Right", "cue_scan": "Scanner", "cue_result": "Result", "cue_back": "tip"},
       "overlay": {"marker_at": "w:Remember"}},
      {"function": "close", "scene_type": "zonk_loop",
       "spoken": "I'll just lie here for a bit. More Zonkfruit? Follow the channel. I'll get up in a minute.",
       "data": {"sign": "FACTS ONLY", "cta": "More Zonkfruit? *Follow.*", "cue_cta": "More", "cue_up": "get", "cue_lie": "lie", "cue_ch": "channel"}}
    ],
    "status": [
      {"beat": "b1", "text": "Space: any echo?", "tone": "amber", "offset": 0.5},
      {"beat": "b1", "text": "Echo: rejected", "tone": "pop", "word": "nobody"},
      {"beat": "b3", "text": "Sound needs molecules", "tone": "lime", "word": "Molecules"},
      {"beat": "b4", "text": "Explosion: silent", "tone": "lime", "word": "explodes"},
      {"beat": "b5", "text": "Astronauts: by radio", "tone": "lime", "word": "radios"},
      {"beat": "b6", "text": "Plümo: echo unknown", "tone": "amber", "word": "Result"},
      {"beat": "b7", "text": "Plümo: lying down", "tone": "muted", "offset": 0.3}
    ],
    "post": {"title": "In space, nobody can hear you. Plümo yelled hello.",
             "description": "Plümo flew his cardboard rocket into space and waited for an echo. But sound needs molecules, and space is a vacuum. That's why astronauts use radio: radio waves cross the vacuum just like light.",
