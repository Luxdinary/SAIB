              "unit": "km"
            },
            "unit": "×",
            "round": 0.01,
            "decimals": 2,
            "expect": 3.25,
            "at": "@164",
            "result_at": "@3.25"
          }
        ]
      },
      "source_ids": [
        "S1",
        "S3"
      ]
    },
    {
      "id": "b4",
      "function": "demonstration",
      "scene_type": "gb_principle",
      "spoken": "Why so long? Here the train runs on piers almost all the way. Yet this one bridge is only about an eighth of the line: 1,318 divided by 164 is about 8.",
