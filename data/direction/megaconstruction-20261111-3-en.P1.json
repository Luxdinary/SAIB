      "source_ids": [
        "S3"
      ]
    },
    {
      "id": "b4",
      "function": "demonstration",
      "scene_type": "gb_calc",
      "spoken": "Now the maths. On average the canal saves around 460 kilometres of detour around Skagen. 460 divided by 98.6 is 4.67. So the detour is well over four and a half times the canal's length.",
      "data": {
        "headline": "The maths",
        "sheet_dy": 470,
        "calcs": [
          {
            "label": "Saving (Skagen detour) ÷ canal length",
            "a": {
              "value": 460,
