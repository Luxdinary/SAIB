      "source_ids": [
        "S3"
      ]
    },
    {
      "id": "b3",
      "function": "explanation",
      "scene_type": "gb_principle",
      "spoken": "The solution: gates that lie on the seabed. Normally they are filled with water. When a flood comes, compressed air pushes the water out. The gate rises, turns on its hinges and closes the inlet.",
      "data": {
        "headline": "The principle",
        "note": "schematic",
        "pins": [
          {
            "anchor": "hinge",
            "text": "Hinge",
            "at": "@hinges",
            "side": "up"
          }
        ],
        "rule": {
          "text": "Air in, water out: the gate rises.",
          "at": "@compressed",
          "dy": 660
        }
      },
      "source_ids": [
        "S2"
      ]
    },
