    },
    {
      "id": "b3",
      "function": "explanation",
      "scene_type": "rv_readout",
      "spoken": "How much, the engineering lecture shows for a mixture at lambda one. Isooctane, a component of petrol, cools the charge by nineteen degrees. Ethanol by eighty degrees, and methanol by as much as a hundred and twenty-eight. So ethanol cools about four times as much as isooctane.",
      "data": {
        "title": "Evaporative cooling",
        "figure": "bars",
        "bar_max": 135,
        "lines_y": 1010,
        "bars": [
          {
            "label": "isooctane",
