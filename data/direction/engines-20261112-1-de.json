    {
      "id": "b4",
      "function": "demonstration",
      "scene_type": "rv_board",
      "spoken": "Erstes Beispiel, ebenfalls von der NASA: Der Motor der Gebrüder Wright von neunzehnhundertdrei hatte vier Zoll Bohrung und vier Zoll Hub. Das ergibt gut fünfzig Kubikzoll pro Zylinder und bei vier Zylindern rund zweihundert. Bohrung und Hub sind hier gleich groß.",
      "data": {
        "title": "Der Wright-Motor",
        "mode": "history",
        "years": [
          {
            "year": "1903",
            "at": 0.0
          }
        ],
