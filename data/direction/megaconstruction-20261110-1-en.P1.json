    {
      "id": "b2",
      "function": "problem",
      "scene_type": "gb_build",
      "spoken": "The data: since June 2011 the Danyang–Kunshan bridge has carried the Beijing–Shanghai high-speed line. The whole line is 1,318 kilometres long, and trade press says more than 85 percent of it runs on bridges and viaducts.",
      "data": {
        "headline": "The data",
        "table_title": "Data sheet",
        "rows": [
          {
            "pos": "1",
            "part": "Danyang–Kunshan bridge",
