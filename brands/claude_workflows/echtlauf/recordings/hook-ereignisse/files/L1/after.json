{
  ".claude/hooks/log.js": "// schreibt den Namen des Hook-Ereignisses (Argument) als neue Zeile in ereignisse.log\nconst fs = require(\"fs\");\nconst path = require(\"path\");\nconst dir = process.env.CLAUDE_PROJECT_DIR || process.cwd();\nfs.appendFileSync(path.join(dir, \"ereignisse.log\"), process.argv[2] + \"\\n\");\n",
  ".claude/settings.json": "{\n  \"hooks\": {\n    \"SessionStart\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"node \\\"$CLAUDE_PROJECT_DIR/.claude/hooks/log.js\\\" SessionStart\"\n          }\n        ]\n      }\n    ],\n    \"UserPromptSubmit\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"node \\\"$CLAUDE_PROJECT_DIR/.claude/hooks/log.js\\\" UserPromptSubmit\"\n          }\n        ]\n      }\n    ],\n    \"PreToolUse\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"node \\\"$CLAUDE_PROJECT_DIR/.claude/hooks/log.js\\\" PreToolUse\"\n          }\n        ]\n      }\n    ],\n    \"PostToolUse\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"node \\\"$CLAUDE_PROJECT_DIR/.claude/hooks/log.js\\\" PostToolUse\"\n          }\n        ]\n      }\n    ],\n    \"Stop\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"node \\\"$CLAUDE_PROJECT_DIR/.claude/hooks/log.js\\\" Stop\"\n          }\n        ]\n      }\n    ]\n  }\n}\n",
  "ereignisse.log": "SessionStart\nUserPromptSubmit\nPreToolUse\nPostToolUse\nStop\n",
  "notiz.txt": "Einkaufsliste: Brot, Milch\n"
}