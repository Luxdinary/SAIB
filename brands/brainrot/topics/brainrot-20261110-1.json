       "scores": {"clarity": 5, "relevance": 4, "curiosity": 4, "truth": 5, "visual": 3}, "source_ids": ["S1"], "visual": "question mark over the starfish"},
      {"type": "surprising_fact", "spoken": "Some starfish have forty arms.", "on_screen": "Up to *40 arms*.",
