      {"beat": "b1", "text": "Paint roller: rejected", "tone": "pop", "word": "painted"},
      {"beat": "b3", "text": "Air scatters sunlight", "tone": "lime", "word": "scatter"},
      {"beat": "b4", "text": "Blue: short waves", "tone": "lime", "word": "Blue"},
      {"beat": "b5", "text": "Purple? Eyes prefer blue", "tone": "lime", "word": "eyes"},
