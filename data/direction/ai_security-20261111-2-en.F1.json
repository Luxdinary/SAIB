  {
   "id": "b3",
   "function": "explanation",
   "scene_type": "sc_inspect",
   "spoken": "Here's what the UK's NCSC says: people forced to change often pick a password similar to the old one. Attackers can then derive it. New passwords are more likely to be written down or forgotten. And many pick a weaker one.",
   "data": {
    "kicker": "According to the NCSC",
    "headline": "What forcing it does",
    "rows": [
     {
      "label": "Similar",
      "value": "derived from the old",
      "verdict": "effect",
      "at": "@similar"
     },
     {
      "label": "Notes",
      "value": "more often written down",
      "verdict": "effect",
      "at": "@written"
     },
     {
      "label": "Weaker",
      "value": "easier to remember",
      "verdict": "effect",
      "at": "@weaker"
     }
    ],
    "fact": {
     "kind": "fakt",
     "text": "Forced changes often make passwords weaker.",
     "source": "NCSC · password expiry",
     "at": 1.2
    }
   },
   "source_ids": [
    "S1"
   ]
  },
  {
