            "label": "Super 100s",
            "kind": "plain"
          },
          {
            "label": "Super 150s",
            "kind": "plain"
          }
        ],
        "labels_at": "w:150s",
        "neq_at": "w:but",
        "source": "Source: Woolmark F-6; 16 CFR 300.20a · retrieved 03.11.2026",
        "backdrop": {
          "src": "library/sw_mood_cuttingtable.jpg",
          "dim": 0.5
        }
      },
      "source_ids": [
        "S1",
        "S2"
